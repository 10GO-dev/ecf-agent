# Variables de entorno para el Agente ECF
# Copiar a .env y ajustar valores

# RNC del cliente (emisor)
CUSTOMER_RNC=101010101

# Autenticacion API TekServices (API Key obtenida desde el portal)
ECF_API_KEY=your_api_key_here

# URL base de la API (Produccion: https://api.tekservices.com.do | Sandbox: https://api-sandbox.tekservices.com.do)
ECF_API_URL=https://api-sandbox.tekservices.com.do

# Entorno (DEV, CERT, PROD)
ECF_ENVIRONMENT=DEV

# Conexion local a Base de Datos ERP
# Drivers soportados: mysql, mariadb, sqlserver, mssql, postgresql, postgres, oracle, sqlite
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_username
DB_PASSWORD=your_db_password

# Consulta SQL local para extraccion (opcional si se gestiona remotamente desde el portal TekServices)
# DB_QUERY="SELECT id, ecf, encf, buyer_rnc, total FROM facturas WHERE estado = 'PENDIENTE'"
# DB_ID_FIELD=id
# DB_ECF_FIELD=ecf


