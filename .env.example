# Variables de entorno para el Agente ECF
# Copiar a .env y ajustar valores

# RNC del cliente (emisor)
CUSTOMER_RNC=101010101

# Autenticación API TekServices (API Key)
ECF_API_KEY=your_api_key_here

# URL base de la API (Producción: https://api.tekservices.com.do)
ECF_API_URL=https://api.tekservices.com.do

# Entorno (DEV, CERT, PROD)
ECF_ENVIRONMENT=DEV

# Conexión local a Base de Datos ERP (mysql, postgresql, sqlserver, oracle, sqlite)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_username
DB_PASSWORD=your_db_password

